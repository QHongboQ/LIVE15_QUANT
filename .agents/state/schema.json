{"$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://live15.local/schemas/loop-state.schema.json", "title": "LIVE15 loop run state", "type": "object", "additionalProperties": false, "required": ["task_id", "iteration", "status", "timestamps", "maker", "validation", "checker", "next_action"], "properties": {"task_id": {"type": "string"}, "iteration": {"type": "integer", "minimum": 0}, "status": {"type": "string", "enum": ["CREATED", "MAKER_RUNNING", "VALIDATING", "CHECKER_RUNNING", "RETRY", "PASS", "BLOCKED", "HUMAN_REVIEW_REQUIRED"]}, "timestamps": {"type": "object", "additionalProperties": {"type": "string"}}, "maker": {"type": "object"}, "validation": {"type": "object"}, "checker": {"type": "object"}, "previous_failure_reason": {"type": ["string", "null"]}, "commit": {"type": ["object", "null"]}, "next_action": {"type": "string"}, "blocker": {"type": ["string", "null"]}, "checker_feedback": {"type": ["object", "null"], "properties": {"criterion": {"type": "string"}, "evidence": {"type": "string"}, "path": {"type": "string"}, "severity": {"type": "string", "enum": ["info", "low", "medium", "high", "critical"]}, "in_scope": {"type": "boolean"}, "correction": {"type": "string"}, "human_review_required": {"type": "boolean"}}}}}
