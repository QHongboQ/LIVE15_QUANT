{
  "schema_version": 1,
  "principle": "ONE COMPONENT ONE OWNER ONE HEALTH TRUTH ONE RECOVERY AUTHORITY",
  "components": [
    {
      "component": "LIVE15Recorder",
      "owner_type": "NOMAD_MANAGED",
      "owner_id": "Nomad:live15-recorder",
      "heartbeat_source": "data/health.json",
      "process_source": "Nomad allocation live15-recorder.recorder[0]",
      "health_source": "Nomad allocation state plus current recorder heartbeat",
      "restart_authority": "Nomad:live15-recorder",
      "criticality": "CRITICAL",
      "run_mode": "ALWAYS_ON"
    },
    {
      "component": "LIVE15ControlCenter",
      "owner_type": "NOMAD_MANAGED",
      "owner_id": "Nomad:live15-control-center",
      "heartbeat_source": "Nomad service check /api/health",
      "process_source": "Nomad allocation live15-control-center.control-center[0]",
      "health_source": "Nomad allocation state plus native /api/health check",
      "restart_authority": "Nomad:live15-control-center",
      "criticality": "DEGRADED_BUT_PROCESS_CAN_CONTINUE",
      "run_mode": "ALWAYS_ON"
    },
    {
      "component": "LIVE15RuntimeSupervisor",
      "owner_type": "SERVICE_MANAGED",
      "owner_id": "WinSW:LIVE15RuntimeSupervisor",
      "heartbeat_source": "runtime/runtime-supervisor-status.json",
      "process_source": "Windows service LIVE15RuntimeSupervisor",
      "health_source": "Windows service state plus current supervisor heartbeat",
      "restart_authority": "WinSW:LIVE15RuntimeSupervisor",
      "criticality": "DEGRADED_BUT_PROCESS_CAN_CONTINUE",
      "run_mode": "ALWAYS_ON"
    },
    {
      "component": "kalshi_sdk_ws_shadow",
      "owner_type": "NOMAD_MANAGED",
      "owner_id": "Nomad:live15-kalshi-sdk-ws-shadow",
      "heartbeat_source": "runtime/kalshi-sdk-ws-shadow-status.json",
      "process_source": "Nomad allocation live15-kalshi-sdk-ws-shadow",
      "health_source": "Nomad allocation state plus shadow heartbeat",
      "restart_authority": "Nomad:live15-kalshi-sdk-ws-shadow",
      "criticality": "DEGRADED_BUT_PROCESS_CAN_CONTINUE",
      "run_mode": "ON_DEMAND"
    },
    {
      "component": "pyth",
      "owner_type": "IN_PROCESS_WORKER",
      "owner_id": "LIVE15Recorder",
      "heartbeat_source": "data/health.json worker_health.pyth",
      "process_source": "LIVE15Recorder",
      "health_source": "parent alive plus accepted Pyth observation progress and session-aware availability",
      "restart_authority": "LIVE15Recorder then Nomad:live15-recorder",
      "criticality": "CRITICAL",
      "run_mode": "ALWAYS_ON_WHEN_ENABLED"
    },
    {
      "component": "coinbase",
      "owner_type": "IN_PROCESS_WORKER",
      "owner_id": "LIVE15Recorder",
      "heartbeat_source": "data/health.json worker_health.coinbase",
      "process_source": "LIVE15Recorder",
      "health_source": "parent alive plus accepted observation progress",
      "restart_authority": "LIVE15Recorder then Nomad:live15-recorder",
      "criticality": "CRITICAL",
      "run_mode": "ALWAYS_ON"
    }
  ]
}
